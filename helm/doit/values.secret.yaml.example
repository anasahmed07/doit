# DoIt Helm Chart - Secret Values
# Copy this file to values.secret.yaml and fill in your actual values.
# IMPORTANT: values.secret.yaml is gitignored — never commit secrets.

global:
  # PostgreSQL connection string (Neon Serverless)
  databaseUrl: "postgresql://user:password@host/dbname?sslmode=require"

  # Better Auth JWT signing secret
  betterAuthSecret: "your-better-auth-secret"

  # Google Gemini API key (for MCP AI assistant)
  geminiApiKey: "your-gemini-api-key"

  # OAuth credentials (optional)
  googleClientId: ""
  googleClientSecret: ""
  githubClientId: ""
  githubClientSecret: ""
